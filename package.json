{
  "name": "tb-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 3000",
    "check:baseline": "bun scripts/check-astro-baseline.mjs",
    "check": "bun run check:baseline && astro check",
    "build": "bun run check && astro build",
    "preview": "astro preview",
    "test": "bun run check && vitest run",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@lucide/astro": "^1.27.0",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0",
    "yaml": "^2.9.0"
  }
}

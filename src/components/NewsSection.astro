---
import { homePage, news } from '../content/content'
import './NewsSection.css'

const { news: newsSection } = homePage
const featuredNews = news.find((article) => article.featured) ?? news[0]
const smallNews = news.filter((article) => article.id !== featuredNews?.id).slice(0, 3)

function getCategoryEmoji(category: string): string {
  if (category === 'Konkurranse') return '🏆'
  if (category === 'Korpsliv') return '🎊'
  return '🎵'
}
---

{
  featuredNews && (
    <section class="news-section">
      <div class="news-container">
        <div class="section-header">
          <div class="section-badge">{newsSection.badge}</div>
          <h2 class="section-title">{newsSection.heading}</h2>
        </div>

        <div class="news-grid">
          <article class="featured-news">
            <div class="featured-image" aria-hidden="true">📸</div>
            <div class="featured-content">
              <span class="news-tag">{featuredNews.category.toUpperCase()}</span>
              <h3 class="featured-title">{featuredNews.title}</h3>
              <p class="featured-description">{featuredNews.summary}</p>
              <a href="/nyheter/" class="read-more-link">{newsSection.featuredLinkLabel}</a>
            </div>
          </article>

          <div class="small-news">
            {
              smallNews.map((article) => (
                <article class="news-item">
                  <div class="news-icon" aria-hidden="true">{getCategoryEmoji(article.category)}</div>
                  <div class="news-item-content">
                    <span class="news-tag">{article.category.toUpperCase()}</span>
                    <h3 class="news-item-title">{article.title}</h3>
                    <p class="news-item-description">{article.summary}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div class="news-footer">
          <a href="/nyheter/" class="view-all-link">{newsSection.allLinkLabel}</a>
        </div>
      </div>
    </section>
  )
}

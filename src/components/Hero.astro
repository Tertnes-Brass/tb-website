---
import { homePage } from '../content/content'
import './Hero.css'

const { hero } = homePage
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media" aria-hidden="true"></div>

  <div class="hero-container">
    <div class="hero-content">
      <h1 id="hero-heading" class="hero-heading">
        {hero.headingLead}{' '}
        <span class="highlight-burgundy">{hero.headingBurgundy}</span>{' '}
        {hero.headingMiddle}{' '}
        <span class="highlight-gold">{hero.headingGold}</span>{hero.headingSuffix}
      </h1>
      <p class="hero-lede">{hero.description}</p>
      <div class="hero-buttons">
        <a href="/program/" class="hero-btn hero-btn-primary">
          {hero.primaryButtonLabel}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
        <a href="/bli-medlem/" class="hero-btn hero-btn-outline">{hero.secondaryButtonLabel}</a>
      </div>
      <p class="hero-facts">{hero.facts}</p>
    </div>
  </div>
</section>

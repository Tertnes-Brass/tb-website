---
import { homePage } from '../content/content'
import './SponsorCTA.css'

const { support } = homePage
---

<section class="sponsor-cta">
  <div class="sponsor-container">
    <div class="decorative-blob blob-1"></div>
    <div class="decorative-blob blob-2"></div>
    <div class="decorative-blob blob-3"></div>

    <div class="sponsor-content">
      <div class="sponsor-badge">{support.badge}</div>
      <h2 class="sponsor-heading">{support.heading}</h2>
      <p class="sponsor-description">{support.description}</p>
      <div class="sponsor-buttons">
        <a href="/stott-oss/" class="button-gold">{support.primaryButtonLabel}</a>
        <a href="/om-oss/" class="button-outline">{support.secondaryButtonLabel}</a>
      </div>
    </div>
  </div>
</section>

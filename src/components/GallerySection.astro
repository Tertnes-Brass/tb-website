---
import { homePage } from '../content/content'
import './GallerySection.css'

const { gallery } = homePage
const wideImageIndexes = new Set([0, 1, 4])
---

<section class="gallery-section">
  <div class="gallery-container">
    <div class="section-header">
      <div class="section-badge">{gallery.badge}</div>
      <h2 class="section-title">{gallery.heading}</h2>
    </div>

    <div class="gallery-grid">
      {
        gallery.items.map((item, index) => (
          <figure class:list={['gallery-item', wideImageIndexes.has(index) && 'gallery-item-span-2']}>
            <img src={item.image} alt={item.imageAlt} class="gallery-image" loading="lazy" />
          </figure>
        ))
      }
    </div>

    <div class="gallery-footer">
      <a href="/nyheter/" class="view-all-button">{gallery.allLinkLabel}</a>
    </div>
  </div>
</section>

---
import { Image } from 'astro:assets'
import Calendar from '@lucide/astro/icons/calendar'
import Clock from '@lucide/astro/icons/clock'
import MapPin from '@lucide/astro/icons/map-pin'
import CalendarClock from '@lucide/astro/icons/calendar-clock'
import Music from '@lucide/astro/icons/music-4'
import ExternalLink from '@lucide/astro/icons/external-link'
import type { Concert } from '../data/concerts'
import { CARD_WIDTHS } from '../lib/images'
import './ProgramCard.css'

interface Props {
  concert: Concert
  /** Set for concerts that have already been held, so they read as archive. */
  isPast?: boolean
}

const { concert, isPast = false } = Astro.props
const isTBA = concert.status === 'tba'
---

<details id={concert.id} class:list={['program-card', isPast && 'program-card-past']}>
  <summary class="program-card-header">
    <span class="program-card-preview">
      {
        concert.image ? (
          <Image
            src={concert.image.source}
            alt={concert.image.alt}
            widths={CARD_WIDTHS}
            sizes="(max-width: 768px) 100vw, 120px"
            class="program-card-image"
            loading="lazy"
          />
        ) : (
          <span class="program-card-marker" aria-hidden="true">
            {isTBA ? <CalendarClock size={22} /> : <Music size={22} />}
          </span>
        )
      }

      <span class="program-card-info">
        <span class="program-card-title" role="heading" aria-level="2">{concert.title}</span>
        <span class="program-card-meta">
          <span class="meta-item">
            <Calendar size={15} aria-hidden="true" />
            <time datetime={concert.isoDate}>{concert.date}</time>
          </span>
          {concert.time !== 'TBA' && (
            <span class="meta-item">
              <Clock size={15} aria-hidden="true" />
              {concert.time}
            </span>
          )}
          <span class="meta-item">
            <MapPin size={15} aria-hidden="true" />
            {concert.venue}
          </span>
        </span>
      </span>

      <span class="expand-icon" aria-hidden="true"></span>
    </span>
  </summary>

  <div class="program-card-details">
    {
      isTBA ? (
        <div class="tba-message">
          <p class="tba-text">Mer informasjon kommer snart</p>
          <p class="tba-description">
            Vi jobber med å planlegge dette arrangementet. Følg med for oppdateringer!
          </p>
        </div>
      ) : (
        <>
          {concert.description && (
            <div class="detail-section">
              <p class="concert-description">{concert.description}</p>
            </div>
          )}

          {concert.program && concert.program.length > 0 && (
            <div class="detail-section">
              <h3 class="detail-heading">Program</h3>
              <ul class="program-list">
                {concert.program.map((item) => (
                  <li
                    class:list={[
                      'program-item',
                      item.type === 'band' ? 'program-band' : 'program-piece',
                    ]}
                  >
                    {item.type === 'band' && (
                      <span class="band-icon" aria-hidden="true">
                        <Music size={16} />
                      </span>
                    )}
                    <div class="program-content">
                      <strong class="program-title">{item.title}</strong>
                      {item.composer && <span class="program-meta"> – {item.composer}</span>}
                    </div>
                  </li>
                ))}
              </ul>
              {concert.extraInfo && <p class="extra-info">{concert.extraInfo}</p>}
            </div>
          )}

          {(concert.ticketPrice || concert.childrenFree) && (
            <div class="detail-section">
              <h3 class="detail-heading">Billetter</h3>
              <p class="ticket-info">
                {concert.ticketPrice && (
                  <span class="ticket-price">Inngangsbillett: {concert.ticketPrice}</span>
                )}
                {concert.childrenFree && <span class="ticket-note"> • Barn har gratis inngang</span>}
              </p>
            </div>
          )}

          {concert.facebookEventUrl && (
            <div class="detail-section">
              <a
                href={concert.facebookEventUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="facebook-link"
              >
                Se arrangementet på Facebook
                <ExternalLink size={16} aria-hidden="true" />
              </a>
            </div>
          )}
        </>
      )
    }
  </div>
</details>
